    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug exp_edaf.py file with arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/exp_edaf.py",
            "console": "integratedTerminal",
            "args": ["data/Nov13th/", "nov13_results/database1.db"]
        }, 
    ]
}